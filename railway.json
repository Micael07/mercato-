{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "node scripts/check-deploy.mjs && node scripts/apply-migrations.mjs && npm run build"
  },
  "deploy": {
    "startCommand": "npm start -- --hostname 0.0.0.0",
    "restartPolicyType": "ON_FAILURE",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 120
  }
}
