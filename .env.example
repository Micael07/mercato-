# Somente valores de exemplo. Não coloque credenciais reais no repositório.
# Ambiente local: mantenha a conexão local fornecida pelo seu PostgreSQL.
# Render/Railway: use a conexão pooled do Neon com sslmode=verify-full.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# Gere com node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Em Blueprint Render, a chave é gerada automaticamente. Nunca use uma senha demo.
AUTH_SECRET=""

# public = bloquear enquadramento por outros sites; preview = permitir o painel de testes.
DEPLOYMENT_TARGET="preview"
ALLOW_DEV_SEED="false"
NEXT_PUBLIC_ENABLE_DEMO="false"

# Apenas no editor/preview, se você quiser baixar o código pelo painel de admin.
# Nunca é aceito no modo public. O script local não depende desta flag.
ALLOW_SOURCE_EXPORT="false"

# true apenas durante o cadastro do administrador; feche depois no painel do host.
ALLOW_PUBLIC_REGISTRATION="true"

# Migrations: crie OUTRO arquivo ignorado chamado .env.migrations.local contendo
# MIGRATION_DATABASE_URL="postgresql://...CONEXAO_DIRETA.../neondb?sslmode=verify-full"
# Não envie a credencial de migrations para o frontend ou para o repositório.

# O login atual usa sessão própria do Mercato. As variáveis de Supabase Auth não
# são usadas por ele; um projeto Supabase exige integração e revisão adicionais.

# Dono da plataforma: só este(s) e-mail(s) liberam o acesso dos clientes (separe por vírgula).
PLATFORM_ADMIN_EMAILS="seu-email@exemplo.com"

# Opcional: contato mostrado quando a licença está vencida/bloqueada (lido no build).
# NEXT_PUBLIC_SUPPORT_CONTACT="WhatsApp (92) 90000-0000"
